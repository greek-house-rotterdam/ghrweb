# Build-time only. Used by the Ticket Tailor content loader in src/content.config.ts
# Get the key from Ticket Tailor → Account → API keys.
TT_API_KEY=

# Used by .github/scripts/translate.py (content auto-translation pipeline)
GEMINI_API_KEY=

# Used by .github/scripts (image / content QA fallbacks)
DEEPL_API_KEY=
