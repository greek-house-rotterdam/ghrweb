---
import { t } from "../i18n/ui";
import LanguagePicker from "./LanguagePicker.astro";
import { hasNews } from "../lib/visible";
import type { Lang } from "../i18n/utils";
import { Sheet, SheetTrigger, SheetContent, SheetHeader, SheetTitle } from "@/components/starwind/sheet";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// Order agreed with the managers (2026-11-17). The logo leads home, so the
// desktop menu has no "Home" item; the mobile menu keeps one.
const navItems = [
  { href: `/${lang}/events`, label: t(lang, "nav.events") },
  { href: `/${lang}/activities`, label: t(lang, "nav.activities") },
  { href: `/${lang}/history`, label: t(lang, "nav.history") },
  ...((await hasNews(lang)) ? [{ href: `/${lang}/news`, label: t(lang, "nav.news") }] : []),
  { href: `/${lang}/about`, label: t(lang, "nav.about") },
  { href: `/${lang}/resources`, label: t(lang, "nav.resources") },
  { href: `/${lang}/faq`, label: t(lang, "nav.faq") },
  { href: `/${lang}/contact`, label: t(lang, "nav.contact") },
];
const mobileItems = [{ href: `/${lang}`, label: t(lang, "nav.home") }, ...navItems];
---

<header class="sticky top-0 z-50 border-b-4 border-black bg-white/95 backdrop-blur-sm">
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4">
    <a href={`/${lang}`} class="inline-block border-2 border-black">
      <img
        src="/images/logo.jpg"
        alt="Het Griekse Huis Rotterdam"
        class="block h-12 w-12 object-contain"
        width="48"
        height="48"
      />
    </a>

    <div class="hidden lg:flex items-center gap-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="px-3 py-2 text-sm font-bold uppercase tracking-wide text-black hover:bg-accent-gold transition-colors"
        >
          {item.label}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-3">
      <LanguagePicker lang={lang} />
      <a
        href={`/${lang}/become-a-member`}
        class="hidden sm:inline-block border-2 border-black bg-primary px-4 py-2 text-sm font-bold text-white shadow-[4px_4px_0_0_#000] hover:bg-primary-dark hover:shadow-none hover:translate-x-1 hover:translate-y-1 active:shadow-none active:translate-x-1 active:translate-y-1 transition-all motion-reduce:transition-none focus-visible:outline-4 focus-visible:outline-offset-2 focus-visible:outline-primary"
      >
        {t(lang, "nav.become-a-member")}
      </a>

      {/* Mobile menu — Starwind Sheet */}
      <Sheet class="lg:hidden">
        <SheetTrigger class="border-2 border-black p-2 shadow-[3px_3px_0_0_#000] hover:bg-accent-gold hover:shadow-none hover:translate-x-[3px] hover:translate-y-[3px] active:shadow-none active:translate-x-[3px] active:translate-y-[3px] transition-all motion-reduce:transition-none focus-visible:outline-4 focus-visible:outline-offset-2 focus-visible:outline-primary">
          <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </SheetTrigger>
        <SheetContent side="right">
          <SheetHeader>
            <SheetTitle>
              <img
                src="/images/logo.jpg"
                alt="Het Griekse Huis Rotterdam"
                class="block h-12 w-12 border-2 border-black object-contain"
                width="48"
                height="48"
              />
            </SheetTitle>
          </SheetHeader>
          <nav class="mt-4 flex flex-col">
            {mobileItems.map((item) => (
              <a
                href={item.href}
                class="px-4 py-3 text-sm font-bold uppercase tracking-wide text-black hover:bg-accent-gold border-b border-black last:border-b-0"
              >
                {item.label}
              </a>
            ))}
            <a
              href={`/${lang}/become-a-member`}
              class="mt-4 mx-4 border-2 border-black bg-primary px-4 py-3 text-center text-sm font-bold uppercase tracking-wide text-white hover:bg-primary-dark transition-all"
            >
              {t(lang, "nav.become-a-member")}
            </a>
          </nav>
        </SheetContent>
      </Sheet>
    </div>
  </nav>
</header>
