---
import Layout from "../../../layouts/Layout.astro";
import { t } from "../../../i18n/ui";
import { getStaticLangPaths, type Lang } from "../../../i18n/utils";
import { getCollection } from "astro:content";
import BrutButton from "../../../components/BrutButton.astro";
import EventCard from "../../../components/EventCard.astro";
import { splitEvents, toListEvents } from "../../../lib/event-list";

export const getStaticPaths = getStaticLangPaths;

const { lang } = Astro.params as { lang: Lang };

const [ttEvents, overlays] = await Promise.all([
  getCollection("events"),
  getCollection("eventTranslations"),
]);

// Upcoming first, then past; both newest first. "Now" is the build time.
const { upcoming, past } = splitEvents(toListEvents(ttEvents, overlays, lang), new Date());
---

<Layout title={t(lang, "nav.events")} lang={lang}>
  <section class="py-16">
    <div class="mx-auto max-w-7xl px-4">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <h1 class="text-4xl font-extrabold text-black">{t(lang, "nav.events")}</h1>
        <BrutButton href={`/${lang}/events/calendar`} size="sm" class="bg-accent-gold">
          {t(lang, "events.calendar-view")} →
        </BrutButton>
      </div>

      <h2 class="mt-10 text-2xl font-extrabold text-black">{t(lang, "home.upcoming-events")}</h2>
      {upcoming.length > 0 ? (
        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {upcoming.map((event) => <EventCard event={event} lang={lang} />)}
        </div>
      ) : (
        <div class="mt-6 border-2 border-black border-dashed bg-gray-50 p-10 text-center">
          <p class="text-gray-500 font-bold">{t(lang, "events.none-upcoming")}</p>
        </div>
      )}

      {past.length > 0 && (
        <>
          <h2 class="mt-16 text-2xl font-extrabold text-black">{t(lang, "events.past")}</h2>
          <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {past.map((event) => <EventCard event={event} lang={lang} />)}
          </div>
        </>
      )}
    </div>
  </section>
</Layout>
