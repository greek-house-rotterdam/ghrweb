---
import Layout from "../../../layouts/Layout.astro";
import { t } from "../../../i18n/ui";
import { formatDate, getStaticLangPaths, type Lang } from "../../../i18n/utils";
import { getCollection } from "astro:content";
import BrutButton from "../../../components/BrutButton.astro";
import BrutCard from "../../../components/BrutCard.astro";

export const getStaticPaths = getStaticLangPaths;

const { lang } = Astro.params as { lang: Lang };

const [ttEvents, overlays] = await Promise.all([
  getCollection("events"),
  getCollection("eventTranslations"),
]);

const overlayMap = new Map<string, (typeof overlays)[number]>();
for (const o of overlays) {
  if (o.data.lang === lang) {
    overlayMap.set(o.data.tt_event_id, o);
  }
}

const events = ttEvents
  .map((e) => {
    const overlay = overlayMap.get(e.id);
    return {
      id: e.id,
      title: overlay?.data.title ?? e.data.name,
      description: overlay?.data.description ?? e.data.description_text,
      start: new Date(e.data.start_iso),
      venue: e.data.venue,
      imageUrl: e.data.image_url,
      soldOut: e.data.sold_out,
    };
  })
  .sort((a, b) => a.start.getTime() - b.start.getTime());
---

<Layout title={t(lang, "nav.events")} lang={lang}>
  <section class="py-16">
    <div class="mx-auto max-w-7xl px-4">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <h1 class="text-4xl font-extrabold text-black">{t(lang, "nav.events")}</h1>
        <BrutButton href={`/${lang}/events/calendar`} size="sm" class="bg-accent-gold">
          {t(lang, "events.calendar-view")} →
        </BrutButton>
      </div>

      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {events.map((event) => (
          <BrutCard tag="a" href={`/${lang}/events/${event.id}`} interactive class="block bg-white overflow-hidden">
            {event.imageUrl && (
              <img
                src={event.imageUrl}
                alt={event.title}
                class="w-full h-40 object-cover border-b-2 border-black"
              />
            )}
            <div class="p-6">
              <div class="flex flex-wrap gap-2">
                <span class="inline-block border border-black bg-primary-light px-2 py-0.5 text-xs font-bold uppercase">
                  {formatDate(event.start, lang)}
                </span>
                {event.venue && (
                  <span class="inline-block border border-black bg-green-100 px-2 py-0.5 text-xs font-bold">
                    📍 {event.venue}
                  </span>
                )}
                {event.soldOut && (
                  <span class="inline-block border border-black bg-red-100 px-2 py-0.5 text-xs font-bold uppercase">
                    {t(lang, "events.sold-out")}
                  </span>
                )}
              </div>
              <h3 class="mt-3 text-lg font-extrabold leading-snug">{event.title}</h3>
              <p class="mt-2 text-sm text-gray-600 line-clamp-2">{event.description}</p>
            </div>
          </BrutCard>
        ))}
      </div>

      {events.length === 0 && (
        <div class="mt-10 border-2 border-black border-dashed bg-gray-50 p-10 text-center">
          <p class="text-gray-500 font-bold">{t(lang, "events.none")}</p>
        </div>
      )}
    </div>
  </section>
</Layout>
