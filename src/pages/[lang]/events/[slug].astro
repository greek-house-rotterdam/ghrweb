---
import Layout from "../../../layouts/Layout.astro";
import { t } from "../../../i18n/ui";
import { formatDate, type Lang } from "../../../i18n/utils";
import { getCollection, render } from "astro:content";
import BrutButton from "../../../components/BrutButton.astro";

export async function getStaticPaths() {
  const [ttEvents, overlays] = await Promise.all([
    getCollection("events"),
    getCollection("eventTranslations"),
  ]);
  const langs: Lang[] = ["gr", "nl", "en"];
  const paths: Array<{
    params: { lang: Lang; slug: string };
    props: {
      event: (typeof ttEvents)[number];
      overlay: (typeof overlays)[number] | null;
    };
  }> = [];
  for (const event of ttEvents) {
    for (const lang of langs) {
      const overlay =
        overlays.find(
          (o) => o.data.tt_event_id === event.id && o.data.lang === lang,
        ) ?? null;
      paths.push({ params: { lang, slug: event.id }, props: { event, overlay } });
    }
  }
  return paths;
}

const { event, overlay } = Astro.props;
const { lang } = Astro.params as { lang: Lang };

const title = overlay?.data.title ?? event.data.name;
const description = overlay?.data.description ?? event.data.description_text;
const start = new Date(event.data.start_iso);
const Content = overlay ? (await render(overlay)).Content : null;
const soldOut = event.data.sold_out;
---

<Layout title={title} description={description} lang={lang}>
  <article class="py-16">
    <div class="mx-auto max-w-3xl px-4">
      <BrutButton href={`/${lang}/events`} size="sm" class="bg-white text-black hover:bg-accent-gold">
        ← {t(lang, "common.back")}
      </BrutButton>

      <div class="mt-8">
        <div class="flex flex-wrap gap-2">
          <span class="inline-block border border-black bg-primary-light px-2 py-0.5 text-xs font-bold uppercase">
            {formatDate(start, lang)}
          </span>
          {event.data.venue && (
            <span class="inline-block border border-black bg-green-100 px-2 py-0.5 text-xs font-bold">
              📍 {event.data.venue}
            </span>
          )}
          {soldOut && (
            <span class="inline-block border border-black bg-red-100 px-2 py-0.5 text-xs font-bold uppercase">
              {t(lang, "events.sold-out")}
            </span>
          )}
          {overlay?.data.translation_locked && (
            <span class="inline-block border border-black bg-blue-100 px-2 py-0.5 text-xs font-bold uppercase">
              {t(lang, "common.manually-edited")}
            </span>
          )}
        </div>
        <h1 class="mt-3 text-3xl font-extrabold text-black sm:text-4xl">{title}</h1>
        <p class="mt-3 text-lg text-gray-600">{description}</p>

        {!soldOut && event.data.checkout_url && (
          <div class="mt-6">
            <BrutButton href={event.data.checkout_url} class="bg-accent-gold">
              {t(lang, "events.buy-tickets")} →
            </BrutButton>
          </div>
        )}
      </div>

      {event.data.image_url && (
        <img
          src={event.data.image_url}
          alt={title}
          class="mt-8 w-full border-2 border-black object-cover"
        />
      )}

      {Content ? (
        <div class="mt-10 border-t-2 border-black pt-8 prose prose-lg max-w-none prose-headings:font-extrabold prose-a:text-primary prose-a:underline prose-a:decoration-2">
          <Content />
        </div>
      ) : event.data.description_html && (
        <div
          class="mt-10 border-t-2 border-black pt-8 prose prose-lg max-w-none prose-headings:font-extrabold prose-a:text-primary prose-a:underline prose-a:decoration-2"
          set:html={event.data.description_html}
        />
      )}
    </div>
  </article>
</Layout>
