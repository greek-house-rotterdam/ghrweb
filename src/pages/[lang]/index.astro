---
import Layout from "../../layouts/Layout.astro";
import { t } from "../../i18n/ui";
import { formatDate, getStaticLangPaths, type Lang } from "../../i18n/utils";
import { getCollection } from "astro:content";
import { getVisible } from "../../lib/visible";
import BrutCard from "../../components/BrutCard.astro";
import { entryPath } from "../../lib/entry-path";
import BrutButton from "../../components/BrutButton.astro";
import { descriptionOrExcerpt } from "../../lib/excerpt";
import EventCard from "../../components/EventCard.astro";
import CardRow from "../../components/CardRow.astro";
import { nextEvents, splitEvents, toListEvents } from "../../lib/event-list";

export const getStaticPaths = getStaticLangPaths;

const { lang } = Astro.params as { lang: Lang };

const allNews = await getVisible("news");
const news = allNews
  .filter((post) => post.data.lang === lang)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

// The 3 soonest upcoming events, soonest first like the events page.
const [ttEvents, overlays] = await Promise.all([
  getCollection("events"),
  getCollection("eventTranslations"),
]);
const { upcoming } = splitEvents(toListEvents(ttEvents, overlays, lang), new Date());
const events = nextEvents(upcoming, 3);

// All visible activities, in the order editors set (the `order` field). They
// show in a row that scrolls sideways (CardRow).
const activities = (await getVisible("activities"))
  .filter((a) => a.data.lang === lang)
  .sort((a, b) => a.data.order - b.data.order);
---

<Layout title={t(lang, "home.hero.title")} lang={lang}>
  {/* Hero */}
  <section
    class="relative border-b-4 border-black pt-12 pb-20 sm:pt-16 sm:pb-28 bg-primary bg-cover bg-center"
    style="background-image: linear-gradient(rgba(13, 94, 175, 0.75), rgba(9, 74, 141, 0.85)), url('/images/rotterdam.jpeg');"
  >
    <div class="relative mx-auto max-w-4xl px-4 text-center">
      {/* The Greek House is the association's cultural group: the board asked to keep that link visible (2026-11-17). */}
      <a href={`/${lang}/about`} class="group inline-flex flex-col items-center gap-3 focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-white">
        {/* The badge is transparent around the ring text, so it sits on a white disc to stay readable on the blue. */}
        <span class="block rounded-full border-2 border-black bg-white p-1">
          <img
            src="/images/vvgn-logo.png"
            alt={t(lang, "history.logo-alt")}
            width="480"
            height="480"
            class="block size-20 sm:size-24"
          />
        </span>
        <span class="text-sm font-semibold text-white underline-offset-4 group-hover:underline sm:text-base">
          {t(lang, "home.hero.union")}
        </span>
      </a>
      <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-white sm:text-6xl">
        {t(lang, "home.hero.title")}
      </h1>
      <p class="mt-6 text-lg font-semibold text-white sm:text-xl max-w-2xl mx-auto">
        {t(lang, "home.hero.welcome")}
      </p>
      <div class="mt-10 flex flex-col sm:flex-row justify-center gap-4">
        <BrutButton href={`/${lang}/about`} class="bg-accent-gold text-black text-lg">
          {t(lang, "nav.about")}
        </BrutButton>
        <BrutButton href={`/${lang}/contact`} class="bg-white text-black text-lg">
          {t(lang, "nav.contact")}
        </BrutButton>
      </div>
    </div>
  </section>

  {/* Latest News (hidden while there are no posts) */}
  {news.length > 0 && (
  <section class="py-16">
    <div class="mx-auto max-w-7xl px-4">
      <h2 class="text-3xl font-extrabold text-black">{t(lang, "home.latest-news")}</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {news.map((post) => (
          <BrutCard href={entryPath("news", post)} class="bg-white p-6">
            <span class="inline-block border border-black bg-accent-gold px-2 py-0.5 text-xs font-bold uppercase">
              {formatDate(post.data.date, lang)}
            </span>
            <h3 class="mt-3 text-lg font-extrabold leading-snug">{post.data.title}</h3>
            <p class="mt-2 text-sm text-gray-600 line-clamp-2">{descriptionOrExcerpt(post.data.description, post.body)}</p>
          </BrutCard>
        ))}
      </div>
      <div class="mt-8">
        <BrutButton href={`/${lang}/news`} size="sm" class="bg-white text-black hover:bg-accent-gold">
          {t(lang, "common.read-more")} →
        </BrutButton>
      </div>
    </div>
  </section>
  )}

  {/* Upcoming Events (hidden while there are none) */}
  {events.length > 0 && (
  <section class="border-y-4 border-black bg-accent-gold-lighter py-16">
    <div class="mx-auto max-w-7xl px-4">
      <h2 class="text-3xl font-extrabold text-black">{t(lang, "home.upcoming-events")}</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {events.map((event) => <EventCard event={event} lang={lang} />)}
      </div>
      <div class="mt-8">
        <BrutButton href={`/${lang}/events`} size="sm" class="bg-white text-black hover:bg-accent-gold">
          {t(lang, "events.all")} →
        </BrutButton>
      </div>
    </div>
  </section>
  )}

  {/* Activities: all of them in a sideways-scrolling row, then a link to the page (hidden while there are none) */}
  {activities.length > 0 && (
  <section class="border-b-4 border-black py-16">
    <div class="mx-auto max-w-7xl px-4">
      <CardRow lang={lang}>
        <h2 slot="heading" class="text-3xl font-extrabold text-black">{t(lang, "activities.title")}</h2>
        {activities.map((activity) => (
          <BrutCard href={entryPath("activities", activity)} class="p-6 bg-white">
            {activity.data.emoji && <span class="text-4xl">{activity.data.emoji}</span>}
            <h3 class="mt-4 text-xl font-extrabold">{activity.data.title}</h3>
            <p class="mt-2 text-sm text-gray-700 line-clamp-3">{descriptionOrExcerpt(activity.data.description, activity.body)}</p>
            {activity.data.schedule && (
              <p class="mt-3 text-xs font-bold text-primary">{activity.data.schedule}</p>
            )}
          </BrutCard>
        ))}
      </CardRow>
      <div class="mt-8">
        <BrutButton href={`/${lang}/activities`} size="sm" class="bg-white text-black hover:bg-accent-gold">
          {t(lang, "activities.all")} →
        </BrutButton>
      </div>
    </div>
  </section>
  )}

  {/* CTA */}
  <section class="py-16">
    <div class="mx-auto max-w-3xl px-4 text-center">
      <div class="border-2 border-l-8 border-black bg-accent-gold-lighter p-10">
        <h2 class="text-3xl font-extrabold">{t(lang, "home.cta.title")}</h2>
        <p class="mt-4 text-gray-600">{t(lang, "home.cta.subtitle")}</p>
        <BrutButton href={`/${lang}/become-a-member`} class="mt-8 bg-primary text-white text-lg">
          {t(lang, "nav.become-a-member")}
        </BrutButton>
      </div>
    </div>
  </section>
</Layout>
