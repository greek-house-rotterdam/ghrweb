---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { t } from "../../i18n/ui";
import { getStaticLangPaths, type Lang } from "../../i18n/utils";
import BrutCard from "../../components/BrutCard.astro";

export const getStaticPaths = getStaticLangPaths;

const { lang } = Astro.params as { lang: Lang };

const items = (await getCollection("historyMilestones", (e) => e.data.lang === lang))
  .map((e) => e.data)
  .sort((a, b) => a.year.localeCompare(b.year));

// Valid linkedSection slugs — used to decide whether a card becomes a link
// to /<lang>/history/<slug> or stays as a static row.
const historySections = await getCollection(
  "historySections",
  (e) => e.data.lang === lang,
);
const sectionSlugs = new Set(
  historySections.map((s) => s.id.split("/").pop()!.replace(/\.md$/, "")),
);

const hasEarlyCommunity = sectionSlugs.has("early-community");
---

<Layout title={t(lang, "history.title")} lang={lang}>
  <section class="py-16">
    <div class="mx-auto max-w-4xl px-4">
      <h1 class="text-4xl font-extrabold text-black">{t(lang, "history.title")}</h1>
      <p class="mt-4 text-lg text-gray-600 max-w-2xl">
        {t(lang, "history.intro")}
      </p>
      {hasEarlyCommunity && (
        <p class="mt-3 text-base text-gray-600 max-w-2xl">
          <a href={`/${lang}/history/early-community`} class="font-bold underline hover:text-primary">
            {t(lang, "history.read-early-community")} →
          </a>
        </p>
      )}

      <div class="mt-12 relative">
        {/* Timeline line */}
        <div class="absolute left-6 top-0 bottom-0 w-1 bg-black sm:left-1/2 sm:-translate-x-0.5"></div>

        <div class="space-y-10">
          {items.map((item, i) => {
            const link = item.linkedSection && sectionSlugs.has(item.linkedSection)
              ? `/${lang}/history/${item.linkedSection}`
              : null;
            const cardInner = (
              <>
                <span class="inline-block border-2 border-black bg-primary px-3 py-1 text-sm font-extrabold text-white">
                  {item.year}
                </span>
                <h3 class="mt-3 text-lg font-extrabold">{item.title}</h3>
                {link && (
                  <span class="mt-3 inline-block text-sm font-bold underline">
                    {t(lang, "common.read-more")} →
                  </span>
                )}
              </>
            );
            return (
              <div class:list={["relative flex items-start gap-6", i % 2 === 0 ? "sm:flex-row" : "sm:flex-row-reverse"]}>
                {/* Dot */}
                <div class="absolute left-6 sm:left-1/2 -translate-x-1/2 z-10">
                  <div class="size-5 border-2 border-black bg-accent-gold rotate-45"></div>
                </div>

                {/* Content */}
                <div class:list={["ml-14 sm:ml-0 sm:w-[calc(50%-2rem)]", i % 2 === 0 ? "sm:pr-8 sm:text-right" : "sm:pl-8"]}>
                  {link ? (
                    <a href={link} class="block no-underline transition-transform hover:-translate-y-0.5">
                      <BrutCard class="bg-white p-5">{cardInner}</BrutCard>
                    </a>
                  ) : (
                    <BrutCard class="bg-white p-5">{cardInner}</BrutCard>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </section>
</Layout>
