---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { t } from "../../i18n/ui";
import { getStaticLangPaths, htmlLang, type Lang } from "../../i18n/utils";
import BrutCard from "../../components/BrutCard.astro";
import { DOCUMENTS } from "../../lib/documents";

export const getStaticPaths = getStaticLangPaths;

const { lang } = Astro.params as { lang: Lang };

const items = (await getCollection("historyMilestones", (e) => e.data.lang === lang))
  .map((e) => e.data)
  .sort((a, b) => a.year.localeCompare(b.year));

// Valid linkedSection slugs — used to decide whether a card becomes a link
// to /<lang>/history/<slug> or stays as a static row.
const historySections = await getCollection(
  "historySections",
  (e) => e.data.lang === lang,
);
const sectionSlugs = new Set(
  historySections.map((s) => s.id.split("/").pop()!.replace(/\.md$/, "")),
);

const hasEarlyCommunity = sectionSlugs.has("early-community");

// Empty on the Greek page: the chronicle's title is already Greek.
const chronicleTranslation = t(lang, "history.chronicle.translation");
---

<Layout title={t(lang, "history.title")} lang={lang}>
  <section class="py-16">
    <div class="mx-auto max-w-4xl px-4">
      {/* The association's logo (#116): on phones above the title, on wider
          screens beside it. */}
      <div class="flex flex-col-reverse gap-6 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h1 class="text-4xl font-extrabold text-black">{t(lang, "history.title")}</h1>
          <p class="mt-4 text-lg text-gray-600 max-w-2xl">
            {t(lang, "history.intro")}
          </p>
          {hasEarlyCommunity && (
            <p class="mt-3 text-base text-gray-600 max-w-2xl">
              <a href={`/${lang}/history/early-community`} class="font-bold underline hover:text-primary">
                {t(lang, "history.read-early-community")} →
              </a>
            </p>
          )}
        </div>
        <img
          src="/images/vvgn-logo.png"
          alt={t(lang, "history.logo-alt")}
          width="480"
          height="480"
          class="size-28 shrink-0 sm:size-40"
        />
      </div>

      {/* The association's chronicle, 1946–1996 (a scanned book, in Greek).
          The title is Greek on every page, so it carries lang="el". */}
      <BrutCard
        href={DOCUMENTS.chronicle}
        type="application/pdf"
        hreflang={htmlLang("gr")}
        class="mt-10 bg-white p-5 no-underline"
      >
        <div class="flex items-start gap-4">
          <span class="shrink-0 border-2 border-black bg-primary px-3 py-1 text-sm font-extrabold text-white">
            PDF
          </span>
          <div>
            <h2 class="text-lg font-extrabold text-black" lang={htmlLang("gr")}>
              {t(lang, "history.chronicle.title")}
            </h2>
            {chronicleTranslation && (
              <p class="text-gray-700">{chronicleTranslation}</p>
            )}
            <p class="mt-1 text-sm text-gray-600">{t(lang, "history.chronicle.author")}</p>
            <span class="mt-3 inline-block text-sm font-bold underline">
              {t(lang, "history.chronicle.details")} →
            </span>
          </div>
        </div>
      </BrutCard>

      <div id="timeline" class="mt-12 relative">
        {/* Timeline line */}
        <div class="absolute left-6 top-0 bottom-0 w-1 bg-black sm:left-1/2 sm:-translate-x-0.5"></div>

        <div class="space-y-10">
          {items.map((item, i) => {
            const link = item.linkedSection && sectionSlugs.has(item.linkedSection)
              ? `/${lang}/history/${item.linkedSection}`
              : null;
            // No photo on the card (#200): photos are inside the linked page.
            const cardInner = (
              <>
                <span class="inline-block border-2 border-black bg-primary px-3 py-1 text-sm font-extrabold text-white">
                  {item.year}
                </span>
                <h3 class="mt-3 text-lg font-extrabold">{item.title}</h3>
                {link && (
                  <span class="mt-3 inline-block text-sm font-bold underline">
                    {t(lang, "common.read-more")} →
                  </span>
                )}
              </>
            );
            return (
              <div class:list={["relative flex items-start gap-6", i % 2 === 0 ? "sm:flex-row" : "sm:flex-row-reverse"]}>
                {/* Dot */}
                <div class="absolute left-6 sm:left-1/2 -translate-x-1/2 z-10">
                  <div class="size-5 border-2 border-black bg-accent-gold rotate-45"></div>
                </div>

                {/* Content */}
                <div class:list={["ml-14 sm:ml-0 sm:w-[calc(50%-2rem)]", i % 2 === 0 ? "sm:pr-8 sm:text-right" : "sm:pl-8"]}>
                  {link ? (
                    <BrutCard href={link} class="bg-white p-5 no-underline">{cardInner}</BrutCard>
                  ) : (
                    <BrutCard class="bg-white p-5">{cardInner}</BrutCard>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </section>
</Layout>
