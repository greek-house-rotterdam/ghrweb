---
import Layout from "../../../layouts/Layout.astro";
import { t } from "../../../i18n/ui";
import type { Lang } from "../../../i18n/utils";
import { getCollection, render } from "astro:content";
import BrutButton from "../../../components/BrutButton.astro";

// Each `page-sections` entry where page === "history" becomes its own
// detail page at /[lang]/history/[slug]. Editors can't add these via
// the admin panel — page-sections is programmatic-only and the Decap
// CMS config no longer exposes it as an editable collection.
export async function getStaticPaths() {
  const all = await getCollection(
    "pageSections",
    (e) => e.data.page === "history",
  );
  return all.map((entry) => {
    const [lang, ...slugParts] = entry.id.split("/");
    const slug = slugParts.join("/").replace(/\.md$/, "");
    return { params: { lang, slug }, props: { entry } };
  });
}

const { entry } = Astro.props;
const { lang } = Astro.params as { lang: Lang };
const { Content } = await render(entry);
---

<Layout title={entry.data.title} lang={lang}>
  <article class="py-16">
    <div class="mx-auto max-w-3xl px-4">
      <BrutButton href={`/${lang}/history`} size="sm" class="bg-white text-black hover:bg-accent-gold">
        ← {t(lang, "history.back-to-timeline")}
      </BrutButton>

      <h1 class="mt-8 text-3xl font-extrabold text-black sm:text-4xl">{entry.data.title}</h1>

      <div class="mt-6 prose prose-lg max-w-none">
        <Content />
      </div>

      <div class="mt-12">
        <BrutButton href={`/${lang}/history`} size="sm" class="bg-white text-black hover:bg-accent-gold">
          ← {t(lang, "history.back-to-timeline")}
        </BrutButton>
      </div>
    </div>
  </article>
</Layout>
