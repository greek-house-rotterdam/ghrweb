---
import Layout from "../../layouts/Layout.astro";
import { t } from "../../i18n/ui";
import { getStaticLangPaths, type Lang } from "../../i18n/utils";
import { getCollection } from "astro:content";
import BrutCard from "../../components/BrutCard.astro";
import BrutButton from "../../components/BrutButton.astro";
import { descriptionOrExcerpt } from "../../lib/excerpt";
import { entryPath } from "../../lib/entry-path";

export const getStaticPaths = getStaticLangPaths;

const { lang } = Astro.params as { lang: Lang };

const allActivities = await getCollection("activities");
const activities = allActivities
  .filter((a) => a.data.lang === lang)
  .sort((a, b) => a.data.order - b.data.order);
---

<Layout title={t(lang, "activities.title")} lang={lang}>
  <section class="py-16">
    <div class="mx-auto max-w-7xl px-4">
      <h1 class="text-4xl font-extrabold text-black">{t(lang, "activities.title")}</h1>
      <p class="mt-4 text-lg text-gray-600 max-w-2xl">
        {t(lang, "activities.intro")}
      </p>
      <p class="mt-4 text-gray-600 max-w-2xl">
        {t(lang, "activities.note")}
      </p>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {activities.map((activity) => (
          <BrutCard tag="a" href={entryPath("activities", activity)} interactive class="block p-6 bg-white">
            {activity.data.emoji && (
              <span class="text-4xl">{activity.data.emoji}</span>
            )}
            <h3 class="mt-4 text-xl font-extrabold">{activity.data.title}</h3>
            <p class="mt-2 text-sm text-gray-700">{descriptionOrExcerpt(activity.data.description, activity.body)}</p>
            {activity.data.schedule && (
              <p class="mt-3 text-xs font-bold text-primary">
                {activity.data.schedule}
              </p>
            )}
          </BrutCard>
        ))}
      </div>

      {activities.length === 0 && (
        <div class="mt-10 border-2 border-black border-dashed bg-gray-50 p-10 text-center">
          <p class="text-gray-500 font-bold">{t(lang, "activities.none")}</p>
        </div>
      )}

      <BrutCard class="mt-12 bg-accent-gold-lighter p-6 max-w-3xl">
        <h2 class="text-xl font-extrabold">{t(lang, "activities.join.title")}</h2>
        <p class="mt-2 text-gray-700">{t(lang, "activities.join.text")}</p>
        <BrutButton href={`/${lang}/contact`} size="sm" class="mt-4 bg-white text-black hover:bg-accent-gold">
          {t(lang, "nav.contact")}
        </BrutButton>
      </BrutCard>
    </div>
  </section>
</Layout>
